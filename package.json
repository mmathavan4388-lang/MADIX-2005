{
  "name": "madix",
  "private": true,
  "version": "1.0.0",
  "description": "MADIX from SAYRIX MATHAV — AI + Social + Creative platform",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:worker": "npm run worker:dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "test": "npm test -w apps/api",
    "migrate": "npm run migrate -w apps/api",
    "seed": "npm run seed -w apps/api"
  },
  "engines": { "node": ">=20" }
}
