# ───────────── MADIX environment (copy to .env; NEVER commit real values) ─────────────
NODE_ENV=development
PORT=4000
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
DATABASE_URL=postgres://madix:madix@localhost:5432/madix
TRUST_PROXY=false                     # true behind nginx/ALB so rate limits see the real client IP

# Secrets — generate with: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
DATA_ENCRYPTION_KEY=change-me-change-me-change-me-change-me   # encrypts admin TOTP secrets at rest

# Object storage: local (dev only) or s3 (AWS S3, Cloudflare R2, MinIO, GCS interop…)
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=                          # e.g. https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
CDN_BASE_URL=                         # e.g. https://cdn.madix.app (public media: posts, reels, avatars, branding)

# Payments — Razorpay (Google Pay, UPI, cards, netbanking, wallets)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (verification, password reset, receipts)
SMTP_URL=                             # smtp://user:pass@smtp.example.com:587
MAIL_FROM="MADIX <no-reply@madix.app>"

# Push notifications (FCM)
FCM_SERVER_KEY=

# One-time Master Admin bootstrap (seed prints the 2FA secret once; remove the password afterwards)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# AI providers: keys live ONLY here. The Admin panel stores just the variable NAME.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# SEED_AI_PROVIDERS='[{"capability":"text","name":"main-llm","adapter":"anthropic","model":"claude-sonnet-5-5","apiKeyEnv":"ANTHROPIC_API_KEY"}]'

WORKER_CONCURRENCY=4
MAX_UPLOAD_MB=200
